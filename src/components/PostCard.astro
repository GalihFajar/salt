---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, date, description, tags } = post.data;
const fmt = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<li class="post-card">
  <div class="post-card-date">{fmt}</div>
  <a href={`${import.meta.env.BASE_URL}posts/${post.slug}`} class="post-card-title">
    {title}
  </a>
  <p class="post-card-desc">{description}</p>
  {tags.length > 0 && (
    <div class="post-card-tags">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  )}
</li>
