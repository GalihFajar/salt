---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<'posts'> };
const { title, date, description, tags } = post.data;
const fmt = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const { Content } = await post.render();
---

<Layout title={title} description={description}>
  <Header />
  <main class="page-content">
    <article>
      <header class="post-header">
        <div class="post-meta">
          <time datetime={date.toISOString()}>{fmt}</time>
          {tags.length > 0 && ` · ${tags.join(', ')}`}
        </div>
        <h1>{title}</h1>
      </header>
      <div class="post-body">
        <Content />
      </div>
    </article>
  </main>
</Layout>
